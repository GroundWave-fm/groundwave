#!/bin/sh

# GroundWave Pre-Push Guard
# 1. Unconditionally protects 'main' from direct pushes (ZERO bypasses)
# 2. Runs local lint and test:coverage quality checks on all branches

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$current_branch" = "main" ]; then
  echo ""
  echo "🛑 ========================================================="
  echo "🛑 DIRECT PUSH TO 'main' IS UNCONDITIONALLY PROHIBITED!"
  echo "🛑 All changes must go through a feature branch and Pull Request."
  echo "🛑"
  echo "🛑 1. Create a branch: git checkout -b <type>/<description>"
  echo "🛑 2. Push branch:     git push origin <branch-name>"
  echo "🛑 3. Open PR:         gh pr create"
  echo "🛑 ========================================================="
  echo ""
  exit 1
fi

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "🛑 ========================================================="
    echo "🛑 DIRECT PUSH TARGETING 'main' IS UNCONDITIONALLY PROHIBITED!"
    echo "🛑 Please push to your feature branch and open a PR."
    echo "🛑 ========================================================="
    echo ""
    exit 1
  fi
done

echo "🛡️ GroundWave Guard: Running pre-push checks (lint & test:coverage)..."
pnpm lint && pnpm test:coverage
