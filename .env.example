# Groundwave Environment Configuration

# App Ports & URLs
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database & Cache
DATABASE_URL=postgresql://groundwave_user:groundwave_password@localhost:5432/groundwave_dev
REDIS_URL=redis://localhost:6379

# Auth & Secrets
JWT_SECRET=groundwave_super_secret_jwt_key_for_dev_only_change_in_prod
MAGIC_LINK_SECRET=groundwave_magic_link_secret

# Stripe Connect (Test Mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage & CDN (S3 / Cloudflare R2 / GCS)
STORAGE_BUCKET_NAME=groundwave-media-dev
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_ENDPOINT=...
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:4000/media

# Audio Fingerprinting (ACRCloud / Audible Magic)
ACRCLOUD_HOST=...
ACRCLOUD_ACCESS_KEY=...
ACRCLOUD_SECRET=...
